# Root Docker Compose Environment Configuration
# Shared database credentials inherited by all prototype runs
DB_USER=lerch
DB_PASSWORD=secretpassword

# Internal container networking hostnames and ports
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MONGO_HOST=mongo
MONGO_PORT=27017

# Host mapping port for Postgres (default 5433 to avoid conflict with host Postgres on 5432)
HOST_POSTGRES_PORT=5433
